.env
__pycache__/
.pytest_cache/

# Pictures are not stored in this repo, except the model faces (perBoy.jpg, perBoy2.jpg, ... perGirl.jpg, perGirl2.jpg, ...)
*.jpg
*.jpeg
*.png
!perBoy*.jpg
!perGirl*.jpg
# Website icons
!web/icons/*.png

# Created when you rate faces with dataset_rater.py
ratings.csv
ratings.csv.tmp
# Remembers the last folder dataset_rater.py used
dataset_rater_settings.json

# The old dlib model, not used any more (so a copy left over from before isn't added by accident)
shape_predictor_68_face_landmarks.dat

# Claude Code agent worktrees
.claude/

# Editor settings (contain paths to this PC's Python)
.vscode/

# Your saved ratings normally live in %APPDATA%\AI Face Rater, never in the repo
history.csv
